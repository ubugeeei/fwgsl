///|
/// `fwgsl` CLI library.
///
/// Drives the full parse -> semantic -> AST lowering -> MIR lowering ->
/// WGSL pipeline. Exposed as pure functions over `String` so they can be
/// tested without depending on a particular MoonBit I/O API surface;
/// the binary entry point in `moonbit/cli/cmd/main` wires these up to
/// real argv / file reading.

///|
pub const VERSION = "0.1.0"

///|
/// Result of running the full compile pipeline on an in-memory source.
pub(all) struct CompileResult {
  /// The parsed program.
  program : @ast.Program
  /// Generated WGSL, or `None` if the pipeline failed before codegen.
  wgsl : String?
  /// Combined diagnostics from every stage (parser + semantic +
  /// ast_lowering + mir lowering).
  diagnostics : Array[@diagnostics.Diagnostic]
  /// `true` if any error-severity diagnostic was reported.
  has_errors : Bool
}

///|
/// Run only the front half (parse + semantic) of the pipeline.
///
/// Returns the diagnostics produced by the parser and semantic analyser
/// combined so callers can render them with `format_diagnostic`.
pub fn check_source(source : String) -> Array[@diagnostics.Diagnostic] {
  let parser = @parser.Parser::new(source)
  let program = parser.parse_program()
  let analyzer = @semantic.SemanticAnalyzer::new()
  analyzer.analyze(program)
  let diags : Array[@diagnostics.Diagnostic] = Array::new()
  for d in parser.diagnostics().all() {
    diags.push(d)
  }
  for d in analyzer.diagnostics().all() {
    diags.push(d)
  }
  diags
}

///|
/// Run the full pipeline on an in-memory source.
pub fn compile_source(source : String) -> CompileResult {
  let parser = @parser.Parser::new(source)
  let program = parser.parse_program()
  let diags : Array[@diagnostics.Diagnostic] = Array::new()
  for d in parser.diagnostics().all() {
    diags.push(d)
  }
  let analyzer = @semantic.SemanticAnalyzer::new()
  analyzer.analyze(program)
  for d in analyzer.diagnostics().all() {
    diags.push(d)
  }
  let lowering = @ast_lowering.AstLowering::new(analyzer)
  let hir = lowering.lower_program(program)
  for d in lowering.diagnostics().all() {
    diags.push(d)
  }
  let has_errors = any_error(diags)
  let wgsl : String? = if has_errors {
    None
  } else {
    match @mir.lower_hir_to_mir(hir) {
      Ok(mir_program) => Some(@wgsl_codegen.emit_wgsl(mir_program))
      Err(errs) => {
        // Promote MIR lowering errors to plain diagnostic messages so the
        // CLI can surface them with the same `severity: message` shape.
        for e in errs {
          diags.push(@diagnostics.Diagnostic::error(e))
        }
        None
      }
    }
  }
  CompileResult::{
    program,
    wgsl,
    diagnostics: diags,
    has_errors: has_errors || any_error(diags),
  }
}

///|
fn any_error(diags : Array[@diagnostics.Diagnostic]) -> Bool {
  for d in diags {
    if d.severity == @diagnostics.Severity::Error {
      return true
    }
  }
  false
}

///|
/// Format a diagnostic with a `file:line:col: severity: message` header
/// and an optional `help:` follow-up line.
pub fn format_diagnostic(
  diag : @diagnostics.Diagnostic,
  file : String,
  source : String
) -> String {
  let severity = match diag.severity {
    Error => "error"
    Warning => "warning"
    Info => "info"
    Hint => "hint"
  }
  let location = if diag.labels.length() > 0 {
    let label = diag.labels[0]
    let (line, col) = offset_to_line_col(source, label.span.start)
    file + ":" + line.to_string() + ":" + col.to_string()
  } else {
    file
  }
  let mut out = location + ": " + severity + ": " + diag.message
  match diag.help {
    Some(help) => out = out + "\n  help: " + help
    None => ()
  }
  out
}

///|
/// Format every diagnostic in `diags` joined with newlines.
pub fn format_diagnostics(
  diags : Array[@diagnostics.Diagnostic],
  file : String,
  source : String
) -> String {
  let mut out = ""
  let mut first = true
  for d in diags {
    if not(first) {
      out = out + "\n"
    }
    first = false
    out = out + format_diagnostic(d, file, source)
  }
  out
}

///|
/// Wrap a successful WGSL emission with the same header banner the
/// Rust CLI uses.
pub fn wrap_wgsl(file : String, wgsl : String) -> String {
  "// Generated by fwgsl compiler v" + VERSION + "\n" +
  "// Source: " + file + "\n\n" + wgsl
}

///|
fn offset_to_line_col(source : String, offset : UInt) -> (Int, Int) {
  let target = offset.reinterpret_as_int()
  let mut line = 1
  let mut col = 1
  let mut i = 0
  let len = source.length()
  while i < len && i < target {
    let c = source.unsafe_charcode_at(i)
    if c == 0x0A {
      line = line + 1
      col = 1
    } else {
      col = col + 1
    }
    i = i + 1
  }
  (line, col)
}

///|
/// Print the CLI usage banner to stdout.
pub fn print_help() -> Unit {
  println("fwgsl " + VERSION)
  println("USAGE:")
  println("    fwgsl <COMMAND> [OPTIONS]")
  println("")
  println("COMMANDS:")
  println("    compile, c  <file>    Compile .fwgsl to .wgsl")
  println("    check       <file>    Type-check without emitting")
  println("    fmt         <file>    Format source code (placeholder)")
  println("    version               Print version")
  println("    help                  Print this help")
}
