///|
test "check_source returns no diagnostics on well-formed input" {
  let diags = check_source("data Color = Red | Green | Blue")
  assert_eq(diags.length(), 0)
}

///|
test "compile_source emits WGSL for a trivial program" {
  let source = "main : I32 -> I32\nmain x = x + 1"
  let result = compile_source(source)
  match result.wgsl {
    Some(wgsl) => assert_true(wgsl.contains("fn main"))
    None =>
      fail(
        "expected WGSL output; got " +
        result.diagnostics.length().to_string() +
        " diagnostics",
      )
  }
  assert_false(result.has_errors)
}

///|
test "compile_source surfaces parse errors" {
  // Unbound `y` triggers a semantic-level diagnostic.
  let source = "f x = y"
  let result = compile_source(source)
  assert_true(result.has_errors)
  match result.wgsl {
    None => ()
    Some(_) => fail("expected None wgsl on semantic error")
  }
}

///|
test "format_diagnostic includes location" {
  let diag = @diagnostics.Diagnostic::error("oops").with_label(
    @diagnostics.Label::primary(@span.Span::new(0, 3), "here"),
  )
  let s = format_diagnostic(diag, "x.fwgsl", "abc")
  assert_true(s.contains("x.fwgsl:1:1"))
  assert_true(s.contains("error: oops"))
}

///|
test "format_diagnostic includes help" {
  let diag = @diagnostics.Diagnostic::error("nope")
    .with_label(@diagnostics.Label::primary(@span.Span::new(0, 0), "here"))
    .with_help("try this instead")
  let s = format_diagnostic(diag, "x.fwgsl", "")
  assert_true(s.contains("  help: try this instead"))
}

///|
test "wrap_wgsl prepends a header" {
  let wgsl = wrap_wgsl("foo.fwgsl", "fn main() {}\n")
  assert_true(wgsl.contains("Generated by fwgsl compiler"))
  assert_true(wgsl.contains("Source: foo.fwgsl"))
  assert_true(wgsl.contains("fn main()"))
}

///|
test "format_source canonicalises whitespace" {
  let out = format_source("f    x   =  x  +  1")
  assert_eq(out, "f x = x + 1\n")
}

///|
test "parse_args: no args -> Help" {
  match parse_args([]) {
    Help => ()
    _ => fail("expected Help")
  }
}

///|
test "parse_args: -h / --help / help all map to Help" {
  for flag in ["-h", "--help", "help"] {
    match parse_args([flag]) {
      Help => ()
      _ => fail("expected Help for `" + flag + "`")
    }
  }
}

///|
test "parse_args: -V / --version / version all map to Version" {
  for flag in ["-V", "--version", "version"] {
    match parse_args([flag]) {
      Version => ()
      _ => fail("expected Version for `" + flag + "`")
    }
  }
}

///|
test "parse_args: compile accepts file, --source, --stdin, and `c` alias" {
  match parse_args(["compile", "foo.fwgsl"]) {
    Compile(File(p)) => assert_eq(p, "foo.fwgsl")
    _ => fail("expected Compile(File)")
  }
  match parse_args(["c", "bar.fwgsl"]) {
    Compile(File(p)) => assert_eq(p, "bar.fwgsl")
    _ => fail("expected Compile(File) for alias `c`")
  }
  match parse_args(["compile", "--source", "main x = x"]) {
    Compile(Inline(s)) => assert_eq(s, "main x = x")
    _ => fail("expected Compile(Inline)")
  }
  match parse_args(["compile", "--stdin"]) {
    Compile(Stdin) => ()
    _ => fail("expected Compile(Stdin)")
  }
}

///|
test "parse_args: check and fmt parse their inputs" {
  match parse_args(["check", "a.fwgsl"]) {
    Check(File(p)) => assert_eq(p, "a.fwgsl")
    _ => fail("expected Check")
  }
  match parse_args(["fmt", "--source", "f x = x"]) {
    Fmt(Inline(s)) => assert_eq(s, "f x = x")
    _ => fail("expected Fmt(Inline)")
  }
}

///|
test "parse_args: unknown command -> Invalid" {
  match parse_args(["wut"]) {
    Invalid(msg) => assert_true(msg.contains("unknown command"))
    _ => fail("expected Invalid")
  }
}

///|
test "parse_args: missing input -> Invalid" {
  match parse_args(["compile"]) {
    Invalid(msg) => assert_true(msg.contains("expected <file>"))
    _ => fail("expected Invalid for missing input")
  }
}

///|
test "parse_args: unknown flag -> Invalid" {
  match parse_args(["compile", "--bogus"]) {
    Invalid(msg) => assert_true(msg.contains("unrecognised flag"))
    _ => fail("expected Invalid for unknown flag")
  }
}

///|
test "parse_args: --source without a value -> Invalid" {
  match parse_args(["compile", "--source"]) {
    Invalid(msg) => assert_true(msg.contains("--source"))
    _ => fail("expected Invalid for missing --source value")
  }
}

///|
test "parse_args: --stdin with extra args -> Invalid" {
  match parse_args(["compile", "--stdin", "extra"]) {
    Invalid(msg) => assert_true(msg.contains("--stdin"))
    _ => fail("expected Invalid for extra args after --stdin")
  }
}

///|
test "run_command: Help returns the banner with exit code 0" {
  let (out, code) = run_command(Help, "", "<help>")
  assert_eq(code, 0)
  assert_true(out.contains("fwgsl "))
  assert_true(out.contains("USAGE:"))
}

///|
test "run_command: Version prints version string" {
  let (out, code) = run_command(Version, "", "")
  assert_eq(code, 0)
  assert_true(out.contains("fwgsl "))
  assert_true(out.contains(VERSION))
}

///|
test "run_command: Compile on well-formed source returns WGSL and exit 0" {
  let source = "main : I32 -> I32\nmain x = x + 1"
  let (out, code) = run_command(
    Compile(Inline(source)),
    source,
    "inline.fwgsl",
  )
  assert_eq(code, 0)
  assert_true(out.contains("Generated by fwgsl compiler"))
  assert_true(out.contains("fn main"))
}

///|
test "run_command: Compile on broken source returns diagnostics + exit 1" {
  let source = "f x = y"
  let (out, code) = run_command(
    Compile(Inline(source)),
    source,
    "inline.fwgsl",
  )
  assert_eq(code, 1)
  assert_true(out.contains("inline.fwgsl"))
  assert_true(out.contains("error:"))
}

///|
test "run_command: Check on ok source prints `ok`" {
  let (out, code) = run_command(
    Check(Inline("data Color = Red | Green | Blue")),
    "data Color = Red | Green | Blue",
    "c.fwgsl",
  )
  assert_eq(code, 0)
  assert_eq(out, "ok")
}

///|
test "run_command: Check on broken source returns diagnostics + exit 1" {
  let source = "f x = y"
  let (out, code) = run_command(Check(Inline(source)), source, "c.fwgsl")
  assert_eq(code, 1)
  assert_true(out.contains("error:"))
}

///|
test "run_command: Fmt canonicalises whitespace" {
  let (out, code) = run_command(
    Fmt(Inline("a   =   1")),
    "a   =   1",
    "x.fwgsl",
  )
  assert_eq(code, 0)
  assert_eq(out, "a = 1\n")
}

///|
test "run_command: Invalid command includes help + exit 2" {
  let (out, code) = run_command(Invalid("bad"), "", "")
  assert_eq(code, 2)
  assert_true(out.contains("bad"))
  assert_true(out.contains("USAGE:"))
}

///|
test "help_text: lists every subcommand" {
  let h = help_text()
  for name in ["compile", "check", "fmt", "version", "help", "--source", "--stdin"] {
    assert_true(h.contains(name))
  }
}
